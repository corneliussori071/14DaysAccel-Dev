# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin
ADMIN_PASSPHRASE=your-secure-admin-passphrase

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic (Claude) - use either ANTHROPIC_API_KEY or CLAUDE_API_KEY
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email (SendGrid) - optional, emails are logged without this
SENDGRID_API_KEY=your-sendgrid-api-key

# Payment (Lemon Squeezy)
LEMON_SQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_VARIANT_ID=your-variant-id
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
