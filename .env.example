# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin
ADMIN_PASSPHRASE=your-secure-admin-passphrase

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic (Claude) - use either ANTHROPIC_API_KEY or CLAUDE_API_KEY
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email (SendGrid) - optional, emails are logged without this
SENDGRID_API_KEY=your-sendgrid-api-key

# Payment (Creem)
# Set CREEM_TEST_MODE=true to use the test API (https://test-api.creem.io/v1)
# Set CREEM_TEST_MODE=false or omit for production (https://api.creem.io/v1)
CREEM_API_KEY=your-creem-api-key
CREEM_WEBHOOK_SECRET=your-creem-webhook-secret
CREEM_TEST_MODE=true
